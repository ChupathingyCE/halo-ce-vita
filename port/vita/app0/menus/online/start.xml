<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style ElDewrito (it stands for h3/start/screen): START, Halo 3's MEDIA | SETTINGS (1.2.0 menu rework, owner Nov 5; port/linux/game/menu_functions.c
start_hub_update; 1.1.3): two tabs, L/R or left/right between them, MEDIA's rows and SETTINGS' categories, each
opening its screen or the settings panel on its tab (the PS Vita's); the focused row's words at the right. -->
<menus>
	<strings name="online/start/text">
		<string text="MEDIA"/>
		<string text="SETTINGS"/>
		<string text="FRIENDS"/>
		<string text="FILE SHARE"/>
		<string text="ACTIVE TRANSFERS"/>
		<string text="GAME MANAGER"/>
		<string text="SCREENSHOTS"/>
		<string text="NEWS &amp; UPDATES"/>
		<!-- (8: 1.2.0's GAME HUB, not in 1.1.x: kept for the indices after it) -->
		<string text=""/>
		<string text="CONTROLS"/>
		<string text="APPEARANCE"/>
		<string text="GRAPHICS"/>
		<string text="SOUND"/>
		<string text="INTERFACE"/>
		<string text="ONLINE"/>
		<string text="ADVANCED"/>
	</strings>
	<widget name="online/start/friends" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="2">
		<on event="a" open="h3/friends/screen"/>
	</widget>
	<widget name="online/start/fileshare" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="3">
		<on event="a" run="port fileshare enter" open="h3/fileshare/screen"/>
	</widget>
	<widget name="online/start/transfers" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="4">
		<on event="a" run="port start panel"/>
		<on event="a" run="port start desktop" open="h3/fileshare/screen"/>
	</widget>
	<widget name="online/start/games" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="5">
		<on event="a" run="port h3 mods init" open="h3/mods/screen"/>
	</widget>
	<widget name="online/start/screenshots" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FF686E67" text_x="8" text_y="1" string_list="online/start/text" string_index="6">
	</widget>
	<widget name="online/start/news" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="7">
		<on event="a" run="port start panel"/>
	</widget>
	<widget name="online/start/media_list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port start"/>
		<on event="left_trigger" run="port start tab"/>
		<on event="right_trigger" run="port start tab"/>
		<on event="left" run="port start tab"/>
		<on event="right" run="port start tab"/>
		<on event="y" open="h3/friends/screen"/>
		<child widget="online/start/friends" y="0"/>
		<child widget="online/start/fileshare" y="18"/>
		<child widget="online/start/transfers" y="36"/>
		<child widget="online/start/games" y="54"/>
		<child widget="online/start/screenshots" y="72"/>
		<child widget="online/start/news" y="90"/>
	</widget>
	<widget name="online/start/controls" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="9">
		<on event="a" run="port start panel"/>
		<on event="a" run="port start desktop" open="ui\shell\main_menu\settings_select\player_setup\player_profile_select_screen" label="settings"/>
	</widget>
	<widget name="online/start/appearance" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="10">
		<on event="a" open="ui\shell\main_menu\settings_select\player_setup\player_profile_select_screen" label="settings"/>
	</widget>
	<widget name="online/start/graphics" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="11">
		<on event="a" run="port start panel"/>
	</widget>
	<widget name="online/start/sound" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="12">
		<on event="a" open="h3/sound/screen"/>
	</widget>
	<widget name="online/start/interface" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="13">
		<on event="a" run="port start panel"/>
	</widget>
	<widget name="online/start/online" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="14">
		<on event="a" run="port start panel"/>
	</widget>
	<widget name="online/start/advanced" type="text" width="224" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="online/start/text" string_index="15">
		<on event="a" run="port start panel"/>
	</widget>
	<widget name="online/start/settings_list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port start"/>
		<on event="left_trigger" run="port start tab"/>
		<on event="right_trigger" run="port start tab"/>
		<on event="left" run="port start tab"/>
		<on event="right" run="port start tab"/>
		<on event="y" open="h3/friends/screen"/>
		<child widget="online/start/controls" y="0"/>
		<child widget="online/start/appearance" y="18"/>
		<child widget="online/start/graphics" y="36"/>
		<child widget="online/start/sound" y="54"/>
		<child widget="online/start/interface" y="72"/>
		<child widget="online/start/online" y="90"/>
		<child widget="online/start/advanced" y="108"/>
	</widget>
	<widget name="online/start/tab_media" type="text" width="160" height="34" font="online/font_header" color="#FFEDEFEE" text_y="1" string_list="online/start/text" string_index="0"/>
	<widget name="online/start/tab_settings" type="text" width="200" height="34" font="online/font_header" color="#FFEDEFEE" text_y="1" string_list="online/start/text" string_index="1"/>
	<bitmap name="online/start/tab_line">
		<frame png="online/rule.png" width="4" height="4"/>
	</bitmap>
	<widget name="online/start/tab_mark" width="150" height="3" bitmap="online/start/tab_line"/>
	<widget name="online/start/desc" type="text" left="262" top="100" width="276" height="160" font="online/font_small" color="#FFB8C1B9"/>
	<widget name="online/start/l_butn" left="180" top="330" width="16" height="16" bitmap="h3/glyph_l"/>
	<widget name="online/start/r_butn" left="198" top="330" width="16" height="16" bitmap="h3/glyph_r"/>
	<widget name="online/start/card" left="250" top="80" width="300" height="236" bitmap="online/card"/>
	<widget name="online/start/screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="port start open"/>
		<on event="b back start" back="true"/>
		<child widget="online/pick/dim"/>
		<child widget="online/pick/header"/>
		<child widget="online/start/card"/>
		<child widget="online/pick/foot"/>
		<child widget="online/start/tab_media" x="-40" y="36"/>
		<child widget="online/start/tab_settings" x="130" y="36"/>
		<child widget="online/start/tab_mark" x="-40" y="72"/>
		<child widget="online/start/desc"/>
		<child widget="online/pick/a_butn"/>
		<child widget="online/pick/select"/>
		<child widget="online/pick/b_butn"/>
		<child widget="online/pick/back"/>
		<child widget="online/start/l_butn"/>
		<child widget="online/start/r_butn"/>
		<child widget="online/start/media_list" x="-40" y="96"/>
		<child widget="online/start/settings_list" x="-40" y="96"/>
	</widget>
</menus>
