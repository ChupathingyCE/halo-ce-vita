<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Online: the campaign lobby (halo3/campaign.xml's, its scene and its rows, in the
multiplayer lobby's geometry since 1.1.3) with the lobbies' SWITCH LOBBY first (menus/online/multiplayer.xml's: CAMPAIGN, MULTIPLAYER, FORGE beside it,
each its words at the right; menu_functions.c online_switch_update), so the rows are SWITCH LOBBY,
HOST SETTINGS, MISSION, DIFFICULTY, START GAME; what is under them moved down a row. HOST SETTINGS
(the other lobbies' row: menus/online/host.xml, its co-op rows) in NETWORK's place, the
connection's status beside it as the other lobbies show it. It stands for h3/campaign/screen in
the Online style (menu_tags.c: online/ for h3/). -->
<menus>
	<!-- (1.1.3, the ElDewrito look after Halo 3's and ODST's lobbies: the multiplayer lobby's
	geometry - the title above a full-height see-through panel, the rows across it on the bar, a
	rule, the status, the mission's picture and its caption, the button key at its foot - so every
	lobby is laid out alike; the rows are the Halo 3 set's, widened, with their handlers: the
	functions find them by their last names) -->
	<widget name="online/campaign/switch_0" type="text" width="176" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="online/lobby_text" string_index="3">
		<on event="a start" run="port online switch multiplayer"/>
	</widget>
	<widget name="online/campaign/switch_1" type="text" width="176" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="online/lobby_text" string_index="4">
		<on event="a start" run="port online switch forge"/>
	</widget>
	<widget name="online/campaign/switch_2" type="text" width="176" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="online/lobby_text" string_index="5">
		<on event="a start" run="port online switch close"/>
	</widget>
	<widget name="online/campaign/switch_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="online/lobby_text" string_index="0">
		<on event="a start" run="port online switch open"/>
	</widget>
	<widget name="online/campaign/host_label" type="text" left="0" top="0" width="160" height="18" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="online/lobby_text" string_index="1"/>
	<widget name="online/campaign/network_status" type="text" left="150" top="3" width="186" height="14" font="online/font_small" color="#FF9AA59C" align="right">
		<data input="port h3 network status"/>
	</widget>
	<widget name="online/campaign/host_row" width="344" height="18" bitmap="online/item" flags="pass_unhandled_to_focused_child">
		<on event="a" run="port host campaign" open="online/host/screen"/>
		<child widget="online/campaign/host_label"/>
		<child widget="online/campaign/network_status"/>
	</widget>
	<widget name="online/campaign/mission_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2">
		<on event="a" run="port cascade missions" open="h3/cascade/screen"/>
	</widget>
	<widget name="online/campaign/difficulty_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2">
		<on event="a" open="h3/difficulty/screen"/>
	</widget>
	<widget name="online/campaign/start_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="h3/campaign_text" string_index="2">
		<on event="a start" run="port h3 campaign start"/>
		<on event="a start" run="main menu switch to solo game"/>
	</widget>
	<widget name="online/campaign/start_coop" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="h3/campaign_text" string_index="2">
		<on event="a start" run="port h3 campaign host" open="ui\shell\main_menu\multiplayer_type_select\connected\pregame\connected_pregame_screen"/>
	</widget>
	<widget name="online/campaign/start_adhoc" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="2" string_list="h3/campaign_text" string_index="2">
		<on event="a start" run="port h3 adhoc coop" otherwise="h3/adhoc/joining"/>
		<on event="a start" run="port h3 campaign host" open="ui\shell\main_menu\multiplayer_type_select\connected\pregame\connected_pregame_screen"/>
	</widget>
	<widget name="online/campaign/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port h3 campaign focus"/>
		<on event="y" open="h3/friends/screen"/>
		<data input="port online switch"/>
		<child widget="online/campaign/switch_2" x="168" y="0"/>
		<child widget="online/campaign/switch_0" x="168" y="19"/>
		<child widget="online/campaign/switch_1" x="168" y="38"/>
		<child widget="online/campaign/switch_row" x="0" y="0"/>
		<child widget="online/campaign/host_row" x="0" y="18"/>
		<child widget="online/campaign/mission_row" x="0" y="36"/>
		<child widget="online/campaign/difficulty_row" x="0" y="54"/>
		<child widget="online/campaign/start_row" x="0" y="76"/>
		<child widget="online/campaign/start_coop" x="0" y="76"/>
		<child widget="online/campaign/start_adhoc" x="0" y="76"/>
	</widget>
	<widget name="online/campaign/title" type="text" left="-52" top="26" width="400" height="34" font="online/font_header" color="#FFEDEFEE" text_y="1" string_list="h3/campaign_text" string_index="0"/>
	<widget name="online/campaign/rule1" left="-54" top="138" width="344" height="1" bitmap="online/rule"/>
	<widget name="online/campaign/rule2" left="-54" top="164" width="344" height="1" bitmap="online/rule"/>
	<widget name="online/campaign/ready" type="text" left="-46" top="170" width="328" height="18" font="online/font_item" color="#FFD2D9D3" text_y="1" string_list="h3/campaign_text" string_index="3"/>
	<widget name="online/campaign/ready_sub" type="text" left="-46" top="187" width="328" height="34" font="online/font_small" color="#FF9AA59C" text_y="1"/>
	<widget name="online/campaign/picture" left="-46" top="226" width="140" height="114" bitmap="h3/sp_levels"/>
	<widget name="online/campaign/emblem" left="-40" top="232" width="44" height="48" bitmap="h3/difficulty"/>
	<widget name="online/campaign/caption" type="text" left="-46" top="346" width="328" height="40" font="online/font_item" color="#FFE4E8E5" text_y="1"/>
	<widget name="online/campaign/warning" type="text" left="-46" top="386" width="328" height="36" font="online/font_small" color="#FFF0B070" text_y="1"/>
	<widget name="online/campaign/a_butn" left="-46" top="427" width="16" height="16" bitmap="h3/glyph_cross"/>
	<widget name="online/campaign/select" type="text" left="-27" top="426" width="60" height="18" font="online/font_item" color="#FFEDEFEE" text_y="1" string_list="h3/campaign_text" string_index="5"/>
	<widget name="online/campaign/b_butn" left="35" top="427" width="16" height="16" bitmap="h3/glyph_circle"/>
	<widget name="online/campaign/back" type="text" left="54" top="426" width="60" height="18" font="online/font_item" color="#FFEDEFEE" text_y="1" string_list="h3/main_items" string_index="10"/>

	<widget name="online/campaign/screen" flags="pass_unhandled_to_focused_child" scene="load_campaign -15 5 0 -20 25 0 50"
		backdrop="load_campaign -54.0 -47.0 47.2 102 18 0 70 | -56.89 -44.56 48.0 35 5.5 60 | -51.63 -47.37 47.0 128 19 60"
		backdrop_object="menu_campaign:warthog 3.6 0.85 0.0 268 pitch=-25 roll=28 level=1;
			menu_campaign:cyborg in=1 seat=driver;
			menu_campaign:marine_armored in=1 seat=gunner;
			menu_campaign:marine_armored in=1 seat=passenger weapon=assault_rifle"
		scene_object="menu_campaign:warthog 4.2 0.82 -0.42 268 pitch=22 roll=14;
			menu_campaign:cyborg in=1 seat=driver;
			menu_campaign:marine_armored in=1 seat=gunner;
			menu_campaign:marine_armored in=1 seat=passenger weapon=assault_rifle">
		<on event="created" run="port h3 campaign init"/>
		<on event="created" run="port h3 scene"/>
		<on event="b back" back="true"/>
		<data input="port h3 campaign"/>
		<child widget="h3/main/haze"/>
		<child widget="online/mp/panel"/>
		<child widget="online/mp/foot"/>
		<child widget="online/campaign/title"/>
		<child widget="online/campaign/rule1"/>
		<child widget="online/campaign/rule2"/>
		<child widget="online/campaign/ready"/>
		<child widget="online/campaign/ready_sub"/>
		<child widget="online/campaign/picture"/>
		<child widget="online/campaign/emblem"/>
		<child widget="online/campaign/caption"/>
		<child widget="online/campaign/warning"/>
		<child widget="online/campaign/a_butn"/>
		<child widget="online/campaign/select"/>
		<child widget="online/campaign/b_butn"/>
		<child widget="online/campaign/back"/>
		<child widget="online/mp/players"/>
		<child widget="online/lobby/main/nameplate"/>
		<child widget="online/lobby/main/party_plates"/>
		<child widget="online/lobby/friends/lobby_panel"/>
		<child widget="online/mp/switch_panel"/>
		<child widget="online/mp/switch_text"/>
		<child widget="online/campaign/list" x="-54" y="66"/>
	</widget>
	<!-- (HOST SETTINGS' NETWORK: the co-op networks, halo3/campaign.xml's SELECT NETWORK laid out as
	this folder's pickers, multiplayer.xml's online/network/screen; it stands for h3/campnet/screen) -->
	<widget name="online/campnet/item_0" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="0">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/item_1" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="1">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/item_2" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="2">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/item_3" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFA6B0A7" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="3">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port h3 campaign network focus"/>
		<data input="port h3 campaign networks"/>
		<child widget="online/campnet/item_0" y="0"/>
		<child widget="online/campnet/item_1" y="18"/>
		<child widget="online/campnet/item_2" y="36"/>
		<child widget="online/campnet/item_3" y="54"/>
	</widget>
	<widget name="online/campnet/title" type="text" left="2" top="36" width="400" height="34" font="online/font_header" color="#FFEDEFEE" text_y="1" string_list="h3/campaign_text" string_index="8"/>
	<widget name="online/campnet/campnet_text" type="text" left="226" top="88" width="272" height="190" font="online/font_small" color="#FFB8C1B9" string_list="h3/campaign_network_text"/>
	<widget name="online/campnet/screen" flags="pass_unhandled_to_focused_child">
		<on event="b back" back="true"/>
		<child widget="online/pick/dim"/>
		<child widget="online/pick/header"/>
		<child widget="online/pick/foot"/>
		<child widget="online/campnet/title"/>
		<child widget="online/campnet/campnet_text"/>
		<child widget="online/pick/a_butn"/>
		<child widget="online/pick/select"/>
		<child widget="online/pick/b_butn"/>
		<child widget="online/pick/back"/>
		<child widget="online/campnet/list" x="6" y="86"/>
	</widget>
</menus>
