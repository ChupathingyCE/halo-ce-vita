<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Online: the Command lobby (halo3/forge_lobby.xml's h3/command/lobby, its rows' handlers
and its functions - port command lobby init, port forge lobby: they find the rows by their last
names -) in the other lobbies' geometry (1.1.3, the ElDewrito look after Halo 3's and ODST's
lobbies: the title above the full-height panel, the rows on the bar, a rule, the status, the
map's picture and its words, the button key at its foot), over the live backdrop as the Forge
lobby's: its spot, the Warthog and 343 Guilty Spark (the scene its Halo 3 screen asks for), and
its camera's shots. It stands for h3/command/lobby in the Online style (menu_tags.c: online/ for
h3/). -->
<menus>
	<widget name="online/command/network_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" open="h3/network/screen"/>
	</widget>
	<widget name="online/command/network_status" type="text" left="96" top="69" width="186" height="14" font="online/font_small" color="#FF9FB6CC" align="right">
		<data input="port h3 network status"/>
	</widget>
	<widget name="online/command/map_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port cascade forge" open="h3/cascade/screen"/>
	</widget>
	<widget name="online/command/objective_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge command objective"/>
	</widget>
	<widget name="online/command/commander_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port command ai level"/>
	</widget>
	<widget name="online/command/side_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a left right" run="port command side"/>
	</widget>
	<widget name="online/command/command_row" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2" string_list="h3/forge_text" string_index="9">
		<on event="a start" run="port forge command prepare" open="h3/command/prepare/screen"/>
		<on event="a start" run="port forge start command"/>
	</widget>
	<widget name="online/command/command_live" type="text" width="344" height="18" bitmap="online/item" font="online/font_item" color="#FFC5D0DD" text_x="8" text_y="2" string_list="h3/forge_text" string_index="9">
		<on event="a start" run="port forge start live" open="ui\shell\main_menu\multiplayer_type_select\connected\4way_profile_select\4way_start2join_screen"/>
	</widget>
