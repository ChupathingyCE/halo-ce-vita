		<child widget="ce/settings/interface/row_name"/>
		<child widget="ce/settings/row_name_small"/>
	</widget>
	<widget name="ce/settings/online/row_name" type="text" left="13" top="5" width="197" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/settings_text" string_index="4"/>
	<widget name="ce/settings/online" left="0" width="224" height="32" bitmap="list_item_bkd">
		<on event="a start" run="port ce options page" open="ce/opt/screen"/>
		<child widget="ce/settings/online/row_name"/>
		<child widget="ce/settings/row_name_small"/>
	</widget>
	<widget name="ce/settings/advanced/row_name" type="text" left="13" top="5" width="197" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/settings_text" string_index="5"/>
