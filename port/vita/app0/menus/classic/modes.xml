		<child widget="ce/settings/sound/row_name"/>
		<child widget="ce/settings/row_name_small"/>
	</widget>
	<widget name="ce/settings/interface/row_name" type="text" left="13" top="5" width="197" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/settings_text" string_index="3"/>
	<widget name="ce/settings/interface" left="0" width="224" height="32" bitmap="list_item_bkd">
