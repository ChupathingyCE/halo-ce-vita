<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Classic+ (1.2.0 menu round 3, owner Nov 8; 1.1.3): the main menu's MEDIA (classic/main.xml)
     in the original menus' look: File Share, Friends and the Game Manager together, as ElDewrito's
     START > MEDIA (online/start.xml): each row opens Classic+'s own screen of it (classic/fileshare.xml,
     friends.xml, mods.xml). (1.2.0's EXTRAS - Forge, Command, Firefight - comes with Command in 1.1.4;
     FORGE stays the main menu's row.) The pictures and fonts are the player's own (ui.map); the heading
     is the port's words drawn in the game's look (tools/classic_menu_art.py) -->
<menus>
	<bitmap name="ce/media/header_art">
		<frame png="classic/{lang}/header_media.png" width="512" height="64"/>
	</bitmap>
	<strings name="ce/modes_text">
		<string text="FILE SHARE"/>
		<string text="FRIENDS"/>
		<string text="GAME MANAGER"/>
	</strings>

	<!-- MEDIA -->
	<widget name="ce/media/header" left="35" top="11" width="512" height="64" bitmap="ce/media/header_art"/>
	<widget name="ce/media/fileshare/row_name" type="text" left="13" top="5" width="197" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/modes_text" string_index="0"/>
	<widget name="ce/media/fileshare" left="0" width="224" height="32" bitmap="list_item_bkd">
		<on event="a start" run="port fileshare enter" open="ce/fileshare/screen"/>
		<child widget="ce/media/fileshare/row_name"/>
	</widget>
	<widget name="ce/media/friends/row_name" type="text" left="13" top="5" width="197" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/modes_text" string_index="1"/>
	<widget name="ce/media/friends" left="0" width="224" height="32" bitmap="list_item_bkd">
		<on event="a start" open="h3/friends/screen"/>
		<child widget="ce/media/friends/row_name"/>
	</widget>
	<widget name="ce/media/mods/row_name" type="text" left="13" top="5" width="197" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/modes_text" string_index="2"/>
	<widget name="ce/media/mods" left="0" width="224" height="32" bitmap="list_item_bkd">
		<on event="a start" run="port h3 mods init" open="ce/mods/screen"/>
		<child widget="ce/media/mods/row_name"/>
	</widget>
	<widget name="ce/media/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<child widget="ce/media/fileshare" x="51" y="78"/>
		<child widget="ce/media/friends" x="51" y="110"/>
		<child widget="ce/media/mods" x="51" y="142"/>
	</widget>
	<widget name="ce/media/screen" flags="pass_unhandled_to_focused_child" bitmap="gradient">
		<on event="b back" back="true"/>
		<child widget="ce/media/header"/>
		<child widget="ce/media/list"/>
		<child widget="cp/key/b_butn"/>
		<child widget="cp/key/back"/>
		<child widget="cp/key/a_butn"/>
		<child widget="cp/key/select"/>
	</widget>
</menus>
