<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Classic+ (1.1.3, owner Nov 21: the main menu as Halo PC's and ChupathingyCE's -
     CAMPAIGN, MULTIPLAYER, PROFILES, SETTINGS, QUIT -, 1.1.3's MEDIA and EXTRAS folded into them,
     classic/main.xml), the screens behind its rows, and the COMMAND and FIREFIGHT lobbies, in the
     original menus' look as classic/forge.xml's FORGE lobby is (a cp/<name> widget stands for
     h3/<name> while the style is Classic+: menu_tags.c menu_tags_online).
     - SETTINGS (the main menu's): ChupathingyCE's SETTINGS - the game's settings, then its files -
       as the Xbox's list screens: CONTROLS ... ADVANCED each Classic+'s own option screen of the
       settings panel's rows (1.1.3, classic/options.xml: port ce options page; the panel stays whole,
       Start opens it too, and ADVANCED's SETTINGS PANEL row), then GAME MANAGER (Halo CE's files, the
       mods, DOWNLOAD FROM STEAM and its WORKSHOP: ChupathingyCE's SETUP's maps and downloads),
       FILE SHARE and FRIENDS - 1.1.3's MEDIA, together as ElDewrito's START > MEDIA has them -, each
       opening Classic+'s own screen of it (classic/mods.xml, fileshare.xml, friends.xml); the
       focused row's words in the description's panel at the right (port ce settings). A PC has no
       settings panel: the option screens' rows are not there (port ce settings; the tests' harness
       shows them, HALO_TEST_CLASSIC_OPTIONS=1).
     - GAME MODES (OpenCE's MULTIPLAYER screen's last row, multiplayer.xml: ChupathingyCE's
       Multiplayer screen holds its FORGE so): Forge, Command and Firefight, each opening its lobby as
       ElDewrito's main menu's rows do (h3/forge/lobby, h3/command/lobby, h3/firefight/lobby:
       cp/forge/lobby and the two below), and GAMETYPES PLUS, the Halo 3 GAME TYPES (Infection's
       rules too), the Multiplayer screen's ninth row until 1.1.3's.
     - QUIT (the main menu's): the question as the Xbox's own questions look - ui.map's
       semi_transparent_grey over the screen, alert_bkd's box, its large_ui and small_ui words -; A
       closes the game (port online exit: on the PS Vita the process's own end, vita_main.c), B goes
       back.
     - COMMAND and FIREFIGHT: the Halo 3 set's lobbies' rows and functions (halo3/forge_lobby.xml,
       menu_functions.c "port command lobby init", "port firefight lobby init": the rows found by
       their names), laid out as cp/forge/lobby, sharing its rows, description panel and key.
     The pictures and fonts are the player's own (ui.map); the headings are the port's words drawn
     in the game's look (tools/classic_menu_art.py; menu_titles.c sets them in the game's own heading
     letters where those spell them) -->
<menus>
	<bitmap name="ce/settings/header_art">
		<frame png="classic/{lang}/header_settings.png" width="512" height="64"/>
	</bitmap>
	<bitmap name="ce/modes/header_art">
		<frame png="classic/{lang}/header_game_modes.png" width="512" height="64"/>
	</bitmap>
	<bitmap name="cp/command/header_art">
		<frame png="classic/{lang}/header_command.png" width="512" height="64"/>
	</bitmap>
	<bitmap name="cp/firefight/header_art">
		<frame png="classic/{lang}/header_firefight.png" width="512" height="64"/>
	</bitmap>
	<strings name="ce/settings_text">
		<string text="CONTROLS"/>
		<string text="GRAPHICS"/>
		<string text="SOUND"/>
		<string text="INTERFACE"/>
		<string text="ONLINE"/>
		<string text="ADVANCED"/>
		<string text="GAME MANAGER"/>
		<string text="FILE SHARE"/>
		<string text="FRIENDS"/>
		<string text="WORKSHOP"/>
	</strings>
	<strings name="ce/modes_text">
		<string text="FORGE"/>
		<string text="COMMAND"/>
		<string text="FIREFIGHT"/>
		<string text="GAMETYPES PLUS"/>
	</strings>
	<strings name="ce/quit_text">
		<string text="QUIT"/>
		<string text="Are you sure you want to quit Halo?"/>
		<string text="%a-button =QUIT   %b-button =CANCEL"/>
	</strings>

