		<child widget="ce/settings/friends/row_name"/>
		<child widget="ce/settings/row_name_small"/>
	</widget>
	<widget name="ce/settings/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port ce settings"/>
		<child widget="ce/settings/controls" x="51" y="78"/>
		<child widget="ce/settings/graphics" x="51" y="110"/>
		<child widget="ce/settings/sound" x="51" y="142"/>
		<child widget="ce/settings/interface" x="51" y="174"/>
		<child widget="ce/settings/online" x="51" y="206"/>
		<child widget="ce/settings/advanced" x="51" y="238"/>
