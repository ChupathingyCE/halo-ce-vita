	<widget name="cp/steam/a_butn" left="488" top="414" width="21" height="26" bitmap="ui\shell\bitmaps\a_butn"/>
	<widget name="cp/steam/select" type="text" left="509" top="414" width="127" height="24" font="ui\large_ui" color="#FF2896FF" string_list="cp/workshop_text" string_index="1" text_flags="no_focus_test"/>
	<widget name="cp/steam/screen" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\gradient">
		<on event="b back" run="port h3 steam back" back="true"/>
		<child widget="cp/steam/header"/>
		<child widget="cp/steam/steam_text"/>
		<child widget="cp/steam/qr_text"/>
		<child widget="cp/steam/rule"/>
