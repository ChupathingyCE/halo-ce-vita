		<on event="a start" run="port h3 steam row" open="h3/workshop/screen"/>
	</widget>
	<widget name="cp/steam/row_4" type="text" width="600" height="17" bitmap="server_item_bkds" font="ui\small_ui" color="#FF2896FF" text_x="12" text_y="1">
		<on event="a start" run="port h3 steam row"/>
	</widget>
	<widget name="cp/steam/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port h3 steam"/>
		<child widget="cp/steam/row_1" y="0"/>
		<child widget="cp/steam/row_2" y="18"/>
		<child widget="cp/steam/row_3" y="36"/>
