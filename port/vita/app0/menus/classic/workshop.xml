<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Classic+'s STEAM WORKSHOP and DOWNLOAD FROM STEAM (1.1.3, the owner's Classic+ plan part A, Nov 24:
     Classic+ opened the Halo 3 look's screens from GAME MANAGER). cp/workshop/screen stands for halo3/workshop.xml's
     h3/workshop/screen and cp/steam/screen for halo3/steam.xml's h3/steam/screen while the style is Classic+
     (menu_tags.c's classic set), so every way in - SETTINGS' WORKSHOP row, GAME MANAGER's DOWNLOAD FROM STEAM and its
     STEAM WORKSHOP row, the settings panel's rows - opens these. The same backend (menu_functions.c "port h3 steam
     ...", "port h3 workshop ...": their widgets found by their last names); only the look is this file's, the Xbox's
     list screens as Classic+'s GAME MANAGER and FILE SHARE have it: ui.map's gradient, the heading at 35,11, the rows
     across the screen on server_item_bkds in small_ui, the focused one lit, under the blue line the focused item's
     picture and facts, the button key at the foot in the Xbox's =WORD form. The Workshop's details page: the picture
     at the left, the facts at the right, the description and the maps inside under them. The pictures, the marks, the
     rating's pips and the download's bar are drawn over the screen (menu_functions.c h3_workshop_draw, its Classic+
     part), the QR as DOWNLOAD FROM STEAM's (h3_steam_qr_draw). Without the Custom Edition files both say so and
     start nothing (menu_functions.c cp_steam_needs_custom_edition). No picture or line of text of Bungie's here: the
     pictures and fonts are the player's ui.map's, the headings made of its letters (menu_titles.c) or the port's
     drawn ones (tools/classic_menu_art.py) -->
<menus>
	<bitmap name="cp/workshop/header_art">
		<frame png="classic/{lang}/header_steam_workshop.png" width="512" height="64"/>
	</bitmap>
	<bitmap name="cp/steam/header_art">
		<frame png="classic/{lang}/header_download_from_steam.png" width="512" height="64"/>
	</bitmap>
	<strings name="cp/workshop_text">
		<string text="START"/>
		<string text="=SELECT"/>
	</strings>

	<!-- ==== DOWNLOAD FROM STEAM: the notice (or the QR's words at the left, the QR drawn at the right), the four rows
	(the sound banks, SIGN IN, STEAM WORKSHOP, SIGN OUT) under the blue line, the key -->
	<widget name="cp/steam/header" left="35" top="11" width="512" height="64" bitmap="cp/steam/header_art"/>
	<widget name="cp/steam/steam_text" type="text" left="40" top="84" width="560" height="196" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/steam/qr_text" type="text" left="40" top="100" width="320" height="180" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/steam/rule" left="24" top="286" width="592" height="2" bitmap="ui\shell\bitmaps\blue"/>
	<widget name="cp/steam/row_1" type="text" width="600" height="17" bitmap="server_item_bkds" font="ui\small_ui" color="#FF2896FF" text_x="12" text_y="1">
		<on event="a start" run="port h3 steam row"/>
	</widget>
	<widget name="cp/steam/row_2" type="text" width="600" height="17" bitmap="server_item_bkds" font="ui\small_ui" color="#FF2896FF" text_x="12" text_y="1">
		<on event="a start" run="port h3 steam row"/>
	</widget>
	<!-- (STEAM WORKSHOP: h3/workshop/screen, which Classic+'s cp/workshop/screen stands for) -->
