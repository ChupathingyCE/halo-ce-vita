<?xml version="1.0" encoding="UTF-8"?>
<!-- STEAM WORKSHOP (GAME MANAGER's DOWNLOAD FROM STEAM, its third row): Halo: MCC's Steam Workshop items for Halo CE,
listed and downloaded on the Vita through the player's own Steam sign-in (port/steamdl/steam_workshop.c,
docs/steam_download_security.md section 7). Halo 3's dialog as DOWNLOAD FROM STEAM's: the title, the rule, the text,
the rows, the buttons in the strip at the foot. First the notice and SIGN IN, then the QR for the Steam app (drawn over
the panel's right side, menu_functions.c h3_steam_qr_draw), then the list: ten items a page, Cross marks one, Square
downloads the marked ones, Triangle searches, L and R turn the page, Left and Right change the order; then the
progress, then the install (every map checked by the game's own map check) and the end (signed out of Steam). Circle
leaves the list (signing out) or cancels a download (it resumes next time). The text and the rows are
menu_functions.c's (port h3 workshop). -->
<menus>
	<strings name="h3/workshop_text">
		<string text="STEAM WORKSHOP"/>
		<string text="Select"/>
		<string text="Download"/>
		<string text="Search"/>
	</strings>

	<widget name="h3/workshop/title" type="text" left="52" top="46" width="536" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1" string_list="h3/workshop_text" string_index="0"/>
