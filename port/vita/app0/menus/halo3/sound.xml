<?xml version="1.0" encoding="UTF-8"?>
<!-- Every menu style: SETTINGS > SOUND (1.2.0 menu rework, owner Nov 5) in Halo 3's settings page look (the
reference's settings-sheet: the title, the name and value columns with "(DEFAULT)", the selected row's
description under them, A Select / B Done): the master volume, Halo's sound classes - music, effects,
dialogue, ambience (dsound_sdl.c halo_sound_class_volume, both games, live) - and the menu music under the
live background. Left and right change the row's value; kept where the setting is (settings.txt on the
PS Vita, whose settings panel's Sound has the same rows; config.toml on a PC). menu_functions.c sound_page_* -->
<menus>
	<strings name="h3/sound/text">
		<string text="SOUND"/>
		<string text="Done"/>
	</strings>
	<widget name="h3/sound/master" type="text" width="520" height="18" bitmap="h3/row" font="h3/font_item" color="#FFA6B0A7" text_x="8" text_y="2"/>
	<widget name="h3/sound/music" type="text" width="520" height="18" bitmap="h3/row" font="h3/font_item" color="#FFA6B0A7" text_x="8" text_y="2"/>
	<widget name="h3/sound/effects" type="text" width="520" height="18" bitmap="h3/row" font="h3/font_item" color="#FFA6B0A7" text_x="8" text_y="2"/>
	<widget name="h3/sound/dialogue" type="text" width="520" height="18" bitmap="h3/row" font="h3/font_item" color="#FFA6B0A7" text_x="8" text_y="2"/>
	<widget name="h3/sound/ambience" type="text" width="520" height="18" bitmap="h3/row" font="h3/font_item" color="#FFA6B0A7" text_x="8" text_y="2"/>
	<widget name="h3/sound/menu_music" type="text" width="520" height="18" bitmap="h3/row" font="h3/font_item" color="#FFA6B0A7" text_x="8" text_y="2"/>
	<widget name="h3/sound/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port sound"/>
		<on event="left" run="port sound left"/>
		<on event="right a" run="port sound right"/>
		<on event="y" open="h3/friends/screen"/>
		<child widget="h3/sound/master" y="0"/>
		<child widget="h3/sound/music" y="19"/>
		<child widget="h3/sound/effects" y="38"/>
		<child widget="h3/sound/dialogue" y="57"/>
		<child widget="h3/sound/ambience" y="76"/>
		<child widget="h3/sound/menu_music" y="95"/>
	</widget>
	<widget name="h3/sound/v_master" type="text" left="330" top="100" width="240" height="18" font="h3/font_item" color="#FFEDEFEE" text_y="2"/>
	<widget name="h3/sound/v_music" type="text" left="330" top="119" width="240" height="18" font="h3/font_item" color="#FFEDEFEE" text_y="2"/>
	<widget name="h3/sound/v_effects" type="text" left="330" top="138" width="240" height="18" font="h3/font_item" color="#FFEDEFEE" text_y="2"/>
	<widget name="h3/sound/v_dialogue" type="text" left="330" top="157" width="240" height="18" font="h3/font_item" color="#FFEDEFEE" text_y="2"/>
	<widget name="h3/sound/v_ambience" type="text" left="330" top="176" width="240" height="18" font="h3/font_item" color="#FFEDEFEE" text_y="2"/>
	<widget name="h3/sound/v_menu_music" type="text" left="330" top="195" width="240" height="18" font="h3/font_item" color="#FFEDEFEE" text_y="2"/>
	<widget name="h3/sound/title" type="text" left="60" top="50" width="400" height="28" font="h3/font_title" color="#FFEDEFEE" text_y="1" string_list="h3/sound/text" string_index="0"/>
	<widget name="h3/sound/desc" type="text" left="68" top="232" width="500" height="80" font="h3/font_small" color="#FFB8C1B9"/>
	<widget name="h3/sound/done" type="text" left="166" top="421" width="70" height="18" font="h3/font_item" color="#FFE4E8E5" text_y="1" string_list="h3/sound/text" string_index="1"/>
	<widget name="h3/sound/screen" flags="pass_unhandled_to_focused_child">
		<on event="b back" back="true"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/start/panel"/>
		<child widget="h3/start/rule"/>
		<child widget="h3/sound/title"/>
		<child widget="h3/sound/desc"/>
		<child widget="h3/sound/v_master"/>
		<child widget="h3/sound/v_music"/>
		<child widget="h3/sound/v_effects"/>
		<child widget="h3/sound/v_dialogue"/>
		<child widget="h3/sound/v_ambience"/>
		<child widget="h3/sound/v_menu_music"/>
		<child widget="h3/pick/strip"/>
		<child widget="h3/pick/a_butn"/>
		<child widget="h3/pick/select"/>
		<child widget="h3/pick/b_butn"/>
		<child widget="h3/sound/done"/>
		<child widget="h3/sound/list" x="60" y="100"/>
	</widget>
</menus>
